# Copy values into your shell or deployment secret manager. Spring does not load .env automatically.
API_USERNAME=activity
AUTH_MODE=cognito
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_REPLACE
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
COGNITO_REDIRECT_URI=http://localhost:8080/login/oauth2/code/cognito
API_PASSWORD=replace-with-a-strong-password
COOKIE_SECURE=false
DATABASE_URL=jdbc:postgresql://localhost:5432/activities
DATABASE_USERNAME=activity
DATABASE_PASSWORD=replace-with-a-strong-database-password
FIRECRAWL_API_KEY=
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b
SQS_ENABLED=false
S3_BUCKET=activity-files
S3_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:4566
SQS_SHORT_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/activities-short.fifo
SQS_LONG_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/activities-long.fifo
# LocalStack only. Production uses the AWS default credentials chain / workload IAM role.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
PUBLIC_BASE_URL=http://localhost:8080
# Generate 32 random bytes and base64-encode them; keep the same key across restarts.
OAUTH_ENCRYPTION_KEY=
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
